{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Headroom Local Community",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "fullscreen": false,
        "visible": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      },
      {
        "label": "launcher",
        "title": "Welcome to Headroom Local Community",
        "width": 760,
        "height": 540,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ]
  }
}
